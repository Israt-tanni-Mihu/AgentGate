<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent gives us managed dependency versions and plugin defaults. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.3</version>
        <relativePath/>
    </parent>

    <groupId>com.agentgate</groupId>
    <artifactId>agentgate-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>AgentGate (parent)</name>
    <description>Governance gateway between AI agents and the tools they call</description>

    <modules>
        <module>gateway</module>
        <module>mock-tools</module>
        <module>agent-sim</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Not managed by Spring Boot, so we pin it here once for all modules. -->
        <springdoc.version>3.2.1</springdoc.version>
        <json-schema-validator.version>3.0.9</json-schema-validator.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <spring-ai.version>2.1.0</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- FR5: validates tool arguments against the tool's JSON Schema. -->
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>
            <!-- FR10: circuit breaker + time limiter per tool (core libraries, no Spring starter). -->
            <!-- FR1: Spring AI's MCP client (gateway -> downstream MCP servers, agent-sim -> gateway). -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
